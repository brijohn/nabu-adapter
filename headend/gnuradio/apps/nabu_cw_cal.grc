options:
  parameters:
    author: Brian Johnson
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: 2026 Brian Johnson
    description: CW carrier for HackRF level calibration. Amplitude 0.7 matches the
      constant envelope of the half-sine OQPSK wheel, so a dBmV reading of this tone
      equals the wheel's power at identical HackRF settings.
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: nabu_cw_cal
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: NABU CW Calibration
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: rf_freq
  id: variable_qtgui_entry
  parameters:
    comment: ''
    entry_signal: editingFinished
    gui_hint: ''
    label: Carrier (Hz)
    type: real
    value: 267.0125e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [256, 8.0]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: 12.624e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [664, 8.0]
    rotation: 0
    state: enabled
- name: tone_offset
  id: variable
  parameters:
    comment: 'Tone sits this far above the HackRF LO so the

      calibration carrier lands away from the LO/DC leakage

      spur.'
    value: 200e3
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [552, 8.0]
    rotation: 0
    state: enabled
- name: tx_vga
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: ''
    label: TX VGA (dB)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '1'
    stop: '47'
    value: '9'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [424, 8.0]
    rotation: 0
    state: enabled
- name: cw_tone
  id: analog_sig_source_x
  parameters:
    affinity: ''
    alias: ''
    amp: '0.7'
    comment: ''
    freq: tone_offset
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: '0'
    phase: '0'
    samp_rate: samp_rate
    showports: 'False'
    type: complex
    waveform: analog.GR_COS_WAVE
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [280, 376.0]
    rotation: 0
    state: enabled
- name: hackrf
  id: soapy_hackrf_sink
  parameters:
    affinity: ''
    alias: ''
    amp: 'False'
    bandwidth: '0'
    center_freq: rf_freq - tone_offset
    comment: ''
    dev_args: ''
    samp_rate: samp_rate
    type: fc32
    vga: tx_vga
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [608, 360.0]
    rotation: 0
    state: enabled

connections:
- [cw_tone, '0', hackrf, '0']

metadata:
  file_format: 1
  grc_version: 3.10.9.2
