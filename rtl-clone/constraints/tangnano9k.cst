// Tang Nano 9K pin constraints

IO_LOC "clk27" 52;
IO_PORT "clk27" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

// board LEDs, active low
IO_LOC "led[0]" 10;
IO_LOC "led[1]" 11;
IO_LOC "led[2]" 13;
IO_LOC "led[3]" 14;
IO_LOC "led[4]" 15;
IO_LOC "led[5]" 16;
IO_PORT "led[0]" IO_TYPE=LVCMOS18;
IO_PORT "led[1]" IO_TYPE=LVCMOS18;
IO_PORT "led[2]" IO_TYPE=LVCMOS18;
IO_PORT "led[3]" IO_TYPE=LVCMOS18;
IO_PORT "led[4]" IO_TYPE=LVCMOS18;
IO_PORT "led[5]" IO_TYPE=LVCMOS18;

// demod_clk clocks the whole design and must use pin 51 (GCLKC_3)
IO_LOC "demod_clk" 51;
IO_LOC "demod_data" 41;
IO_PORT "demod_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "demod_data" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

// UART to the NABU PC: pins 17/18 on the USB UART bridge, 27/28 for an
// external RS-422 transceiver
IO_LOC "uart_rxd" 18;
IO_LOC "uart_txd" 17;
// IO_LOC "uart_rxd" 27;
// IO_LOC "uart_txd" 28;
IO_PORT "uart_rxd" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "uart_txd" IO_TYPE=LVCMOS33;

// MC145155 PLL serial interface to the RF can
IO_LOC "pll_enb" 29;
IO_LOC "pll_clk" 30;
IO_LOC "pll_data" 25;
IO_PORT "pll_enb" IO_TYPE=LVCMOS33;
IO_PORT "pll_clk" IO_TYPE=LVCMOS33;
IO_PORT "pll_data" IO_TYPE=LVCMOS33;
